{
  "name": "@wikidata-rs/node",
  "version": "0.3.1",
  "description": "Stream Wikidata JSON dumps in Node.js: parallel bzip2, filters before parsing, typed and normalised entities, compact subsets, with bounded memory (Rust, N-API).",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "yarn@4.5.1",
  "homepage": "https://github.com/the-haus/wikidata-rs/tree/main/crates/bindings/wikidata-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-haus/wikidata-rs.git",
    "directory": "crates/bindings/wikidata-node"
  },
  "keywords": [
    "wikidata",
    "dump",
    "json",
    "bzip2",
    "streaming",
    "wikibase",
    "napi",
    "rust"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "examples/",
    "wikidata-node.*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "name": "wikidata-node",
    "package": {
      "name": "@wikidata-rs/node"
    },
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:native": "napi build --platform --release --js false --dts native.generated.d.ts",
    "build:native:debug": "napi build --platform --js false --dts native.generated.d.ts",
    "build:ts": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/copy-native.mjs",
    "build": "yarn run build:native && yarn run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dir -t .",
    "copy-license": "node -e \"const fs=require('fs');fs.copyFileSync('../../../LICENCE.txt','LICENSE');fs.copyFileSync('../../../CHANGELOG.md','CHANGELOG.md')\"",
    "prepack": "yarn run copy-license && yarn run build",
    "pack:dry": "npm pack --dry-run",
    "smoke:install": "bash scripts/smoke-install.sh"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^22.7.4",
    "esbuild": "^0.21.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.1"
  }
}
